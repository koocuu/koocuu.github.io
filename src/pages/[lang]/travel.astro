---
import SiteNav from '@components/SiteNav.astro';
import TravelMap from '@components/TravelMap.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { normalizeLang } from '@data/i18n';
import { hometownPlaces, mappableTravelPlaces, travelPlaces, travelPlacesByYear, type TravelKind } from '../../lib/travel';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }];
}

const lang = normalizeLang(Astro.params.lang);
const kindLabels: Record<TravelKind, string> = {
  travel: '旅行',
  live: '生活',
  work: '工作',
  transit: '途经',
};
const countries = new Set(travelPlaces.map((place) => place.country)).size;
const cities = new Set(travelPlaces.map((place) => `${place.country}/${place.city}`)).size;
const earliestYear = travelPlacesByYear.at(-1)?.[0] ?? '—';
---

<BaseLayout lang={lang} title="足迹" description="我在哪些地方留下过时间。Cu 的个人时间地图。">
  <SiteNav lang={lang} />
  <main class="travel-page" data-travel-page>
    <section class="travel-hero section-shell">
      <p class="eyebrow">足迹</p>
      <h1>我在哪些地方<br />留下过时间</h1>
      <p class="page-lede">一些地方、一些月份，和我仍然记得的事。</p>
    </section>

    <section class="section-shell travel-explorer" aria-label="足迹浏览">
      <div class="travel-tabs" role="tablist" aria-label="切换足迹视图">
        <button id="timeline-tab" type="button" role="tab" aria-selected="true" aria-controls="timeline-panel" data-view="timeline">
          时间轴
        </button>
        <button id="map-tab" type="button" role="tab" aria-selected="false" aria-controls="map-panel" data-view="map" tabindex="-1">
          地图
        </button>
      </div>

      <div id="timeline-panel" class="travel-panel" role="tabpanel" aria-labelledby="timeline-tab">
        <div class="travel-years">
          {travelPlacesByYear.map(([year, places]) => (
            <section class="travel-year" aria-labelledby={`year-${year}`}>
              <h2 id={`year-${year}`}>{year}</h2>
              <div class="travel-year-places">
                {places.map((place) => (
                  <article id={place.id} class:list={['travel-entry', `kind-${place.kind}`]}>
                    <div class="travel-entry-date">
                      <time datetime={place.visited}>{place.visited.slice(5) || place.visited}</time>
                      <span>{kindLabels[place.kind]}</span>
                    </div>
                    <div class="travel-entry-copy">
                      <h3>{place.city} · {place.country}</h3>
                      <p>{place.note}</p>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
          {hometownPlaces.length > 0 && (
            <section class="travel-year travel-hometowns" aria-labelledby="hometown-title">
              <h2 id="hometown-title">家乡</h2>
              <div class="travel-year-places">
                {hometownPlaces.map((place) => (
                  <article id={place.id} class:list={['travel-entry', 'kind-live']}>
                    <div class="travel-entry-date">
                      <span>家乡</span>
                    </div>
                    <div class="travel-entry-copy">
                      <h3>{place.city} · {place.country}</h3>
                      {place.note && <p>{place.note}</p>}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}
        </div>
      </div>

      <div id="map-panel" class="travel-panel" role="tabpanel" aria-labelledby="map-tab" hidden>
        <p class="travel-map-note">地图只标出有坐标的记录；缺坐标的地方仍会留在时间轴里。</p>
        <TravelMap places={mappableTravelPlaces} />
      </div>
    </section>

    <section class="section-shell travel-stats" aria-label="足迹概览">
      <div><strong>{countries}</strong><span>个国家与地区</span></div>
      <div><strong>{cities}</strong><span>座城市</span></div>
      <div><strong>{earliestYear}</strong><span>最早一条记录</span></div>
    </section>
  </main>
</BaseLayout>
