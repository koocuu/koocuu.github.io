---
import SiteNav from '@components/SiteNav.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { copy, languages, normalizeLang } from '@data/i18n';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = normalizeLang(Astro.params.lang);
const t = copy[lang];
const c = t.decisionCase;
---

<BaseLayout lang={lang} title={c.title} description={c.description}>
  <SiteNav lang={lang} />
  <main>
    <section class="page-title section-shell case-title">
      <a class="text-link" href={`/${lang}/`} data-astro-prefetch="hover">{c.backLabel}</a>
      <p class="eyebrow">{c.eyebrow}</p>
      <p class="project-status">{c.status}</p>
      <h1>{c.heading}</h1>
      <p class="page-lede">{c.lede}</p>
      <div class="case-hero-cta">
        <a class="button primary" href={c.liveUrl} target="_blank" rel="noreferrer">{c.tryLabel}</a>
        <a class="button ghost" href={`/${lang}/blog/${c.blogSlug}/`} data-astro-prefetch="hover">{c.blogLabel}</a>
      </div>
    </section>

    <section class="section-shell split-section">
      <div>
        <p class="eyebrow">{c.problem.eyebrow}</p>
        <h2>{c.problem.title}</h2>
      </div>
      <div class="section-copy">
        <p>{c.problem.body}</p>
      </div>
    </section>

    <section class="section-shell split-section">
      <div>
        <p class="eyebrow">{c.solution.eyebrow}</p>
        <h2>{c.solution.title}</h2>
      </div>
      <div class="section-copy">
        <p>{c.solution.body}</p>
        <ol class="case-steps">
          {c.solution.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section-shell">
      <div class="section-header compact">
        <div>
          <p class="eyebrow">{c.decisions.eyebrow}</p>
          <h2>{c.decisions.title}</h2>
        </div>
      </div>
      <div class="principle-grid">
        {c.decisions.items.map((item) => (
          <article class="principle-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell split-section">
      <div>
        <p class="eyebrow">{c.stack.eyebrow}</p>
        <h2>{c.stack.title}</h2>
      </div>
      <div class="section-copy">
        <p>{c.stack.body}</p>
        <div class="tag-row large">
          {c.stack.items.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </section>

    <section class="section-shell split-section">
      <div>
        <p class="eyebrow">{c.outcome.eyebrow}</p>
        <h2>{c.outcome.title}</h2>
      </div>
      <div class="section-copy">
        <p>{c.outcome.body}</p>
      </div>
    </section>

    <section class="section-shell case-cta-band">
      <div>
        <p class="eyebrow">{c.cta.eyebrow}</p>
        <h2>{c.cta.title}</h2>
        <p class="section-intro">{c.cta.body}</p>
      </div>
      <div class="case-hero-cta">
        <a class="button primary" href={`/${lang}/contact/`} data-astro-prefetch="hover">{c.contactLabel}</a>
        <a class="button ghost" href={c.liveUrl} target="_blank" rel="noreferrer">{c.tryLabel}</a>
      </div>
    </section>
  </main>
</BaseLayout>
