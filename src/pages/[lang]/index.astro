---
import { getCollection } from 'astro:content';
import SiteNav from '@components/SiteNav.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { copy, languages, normalizeLang } from '@data/i18n';
import { loadNowPage } from '../../lib/now';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = normalizeLang(Astro.params.lang);
const t = copy[lang];
const now = loadNowPage();
const recentPosts = (await getCollection('blog', ({ data }) => !(data as { private?: boolean }).private))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);

const titleTransitionName = (slug: string) => `post-${slug.replace(/[^\p{L}\p{N}]+/gu, '-')}`;

// Split the headline for the staggered type-settling animation: Latin words stay whole,
// CJK animates per character, and punctuation is glued to the previous token so it can
// never land at the start of a line (kinsoku shori).
const rawTokens = t.home.headline.match(/[A-Za-z0-9]+|\s+|./gu) ?? [];
const mergedTokens: string[] = [];
for (const tok of rawTokens) {
  if (mergedTokens.length > 0 && /^[^\p{L}\p{N}\s]+$/u.test(tok)) {
    mergedTokens[mergedTokens.length - 1] += tok;
  } else {
    mergedTokens.push(tok);
  }
}
let chIndex = 0;
const heroTokens = mergedTokens.map((tok) => (/^\s+$/.test(tok) ? { tok, i: -1 } : { tok, i: chIndex++ }));
---

<BaseLayout lang={lang} title="Cu" description={lang === 'zh' ? '代码越来越便宜，判断越来越贵。Cu 的个人网站与博客。' : 'Code is getting cheaper. Judgment is getting more expensive. Cu’s personal site and blog.'}>
  <SiteNav lang={lang} />
  <main>
    <section class="hero section-shell">
      <div class="hero-copy">
        <p class="eyebrow">{t.home.eyebrow}</p>
        <h1 class="hero-headline" aria-label={t.home.headline}>
          {heroTokens.map(({ tok, i }) =>
            i < 0 ? tok : <span class="hh-ch" aria-hidden="true" style={`--ch-i:${i}`}>{tok}</span>
          )}
        </h1>
        <p class="hero-note">{t.home.note}</p>
        <div class="hero-cta">
          <a class="button primary" href="#projects">{t.home.viewWork}</a>
          <a class="button ghost" href="#recent">{t.home.readBlog}</a>
        </div>
      </div>
      {now.ok && (
        <a class="hero-now" href={`/${lang}/now/`} data-astro-prefetch="hover">
          <p class="eyebrow">{t.now.eyebrow} · {now.season}</p>
          <p class="hero-now-line">{now.headline || t.home.nowFallback}</p>
        </a>
      )}
    </section>

    <section class="section-shell" id="projects">
      <div class="section-header compact">
        <div>
          <p class="eyebrow">{t.home.projectsEyebrow}</p>
          <h2>{t.home.projectsTitle}</h2>
        </div>
      </div>
      <div class="project-grid">
        {t.projects.map((project) => (
          <article class="project-card compact">
            <div class="project-card-header">
              <div>
                <p class="project-status">{project.status}</p>
                <h3>{project.title}</h3>
              </div>
              <div class="project-card-links">
                <a class="text-link" href={`/${lang}/projects/${project.slug}/`} data-astro-prefetch="hover">
                  {project.caseLabel}
                </a>
                <a class="text-link" href={project.href} target="_blank" rel="noreferrer">
                  {project.visitLabel}
                </a>
              </div>
            </div>
            <p>{project.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell" id="recent">
      <div class="section-header compact">
        <div>
          <p class="eyebrow">{t.home.recentEyebrow}</p>
          <h2>{t.home.recentTitle}</h2>
        </div>
        <a class="text-link" href={`/${lang}/blog/`} data-astro-prefetch="hover">{t.home.allPosts}</a>
      </div>
      <div class="recent-list">
        {recentPosts.map((post) => {
          const slug = post.id.replace(/\.md$/, '');
          return (
            <a class="recent-item" href={`/${lang}/blog/${slug}/`} data-astro-prefetch="hover">
              <h3 transition:name={titleTransitionName(slug)}>{post.data.title}</h3>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section-shell home-contact">
      <a class="text-link" href={`/${lang}/contact/`} data-astro-prefetch="hover">{t.home.contactCta}</a>
    </section>
  </main>
</BaseLayout>
